# ─── PayPal Sandbox ──────────────────────────────────────────────────────────
# Get from developer.paypal.com → Apps & Credentials → Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com

# ─── Database ─────────────────────────────────────────────────────────────────
# Render Postgres connection string
DATABASE_URL=postgresql://user:password@host:5432/agent_leash

# ─── Redis (BullMQ) ──────────────────────────────────────────────────────────
# Render Key Value (Redis-compatible)
REDIS_URL=redis://localhost:6379

# ─── LLM (Policy Judge) ──────────────────────────────────────────────────────
# Disclose this provider in hackathon submission
OPENAI_API_KEY=

# ─── Channel3 ────────────────────────────────────────────────────────────────
# Get from Devpost resources page / Channel3 docs
CHANNEL3_API_KEY=
CHANNEL3_BASE_URL=https://api.channel3.ai

# ─── Leash Gateway ────────────────────────────────────────────────────────────
# Internal shared secret between cockpit and gateway
LEASH_INTERNAL_SECRET=
COCKPIT_URL=http://localhost:3001
LEASH_GATEWAY_URL=http://localhost:3000
PORT=3000

# ─── Cockpit (Next.js) ────────────────────────────────────────────────────────
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=

# ─── Demo Store ───────────────────────────────────────────────────────────────
DEMO_STORE_PORT=3002

# ─── Demo Agent ───────────────────────────────────────────────────────────────
# Scoped API key tied to a single mandate (generated by the cockpit)
LEASH_AGENT_API_KEY=

# ─── Render Workflows ─────────────────────────────────────────────────────────
# For long-running timers (delivery SLA, reauth, price watch)
RENDER_API_KEY=

# ─── Cryptography ─────────────────────────────────────────────────────────────
# Ed25519 private key for the gateway (signs decision receipts)
# Generate with: node -e "const {generateKeyPairSync} = require('crypto'); const {privateKey} = generateKeyPairSync('ed25519', {privateKeyEncoding:{type:'pkcs8',format:'der'}}); console.log(privateKey.toString('hex'))"
GATEWAY_PRIVATE_KEY_HEX=

# ─── Observability ────────────────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=development
