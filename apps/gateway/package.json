{
  "name": "@leash/gateway",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/server.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "test": "vitest run",
    "test:adversarial": "vitest run --reporter=verbose src/tests/adversarial",
    "typecheck": "tsc --noEmit",
    "db:migrate": "pnpm --filter @leash/db db:migrate"
  },
  "dependencies": {
    "@hono/node-server": "^2.1.5",
    "@leash/crypto": "workspace:*",
    "@leash/db": "workspace:*",
    "@leash/ledger": "workspace:*",
    "@leash/payment-orchestrator": "workspace:*",
    "@leash/policy-engine": "workspace:*",
    "@leash/types": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@paypal/agent-toolkit": "^1.11.0",
    "@paypal/paypal-server-sdk": "^0.6.1",
    "bullmq": "^5.10.0",
    "express": "^4.19.2",
    "hono": "^4.4.0",
    "ioredis": "^5.4.1",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.0",
    "tsx": "^4.15.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  }
}
